    <string name="rules_title">RULES</string>
    <string name="rules_how_to_play">HOW TO PLAY</string>
    <string name="rules_how_to_play_text">Swap two neighbouring gems to line up 3 or more of the same colour. Matched gems disappear and new ones fall from above.</string>
    <string name="rules_goal">GOAL</string>
    <string name="rules_goal_text">Every level asks you to collect gems of one colour in %d moves. The goal grows by one gem every 4 levels.</string>
    <string name="rules_stars">STARS</string>
    <string name="rules_stars_text">Collect the whole goal for 3 stars, at least half of it for 2 stars, less than half for 1 star. Collect nothing and the level is failed.</string>
    <string name="rules_score">SCORE</string>
    <string name="rules_score_text">Every gem gives 10 points, a line of 4 gives 50 more, a line of 5 gives 100 more. New matches from falling gems multiply the points. Every move left after the goal is done gives 50 points.</string>
    <string name="rules_coins">COINS</string>
    <string name="rules_coins_text">Every star gives 50 coins, also when you play a level again.</string>
    <string name="rules_daily_reward">DAILY REWARD</string>
    <string name="rules_daily_reward_text">Tap DAILY REWARD in the menu once a day to get %1$d coins. A new reward is ready every day at midnight. Turn on Notifications in the settings to get a reminder at %2$d:00 the next morning.</string>
    <string name="rules_hint_shuffle">HINT &amp; SHUFFLE</string>
    <string name="rules_hint_shuffle_text">HINT shows a possible move for %1$d coins. SHUFFLE mixes the board for %2$d coins.</string>
    <string name="rules_skins">SKINS</string>
    <string name="rules_skins_text">Buy skins in the shop. Gems of your skin\'s colour give double points.</string>
